<script>
// 1) define your milestones:
const milestones = [
{ seconds: 70, label: "70 sec" },
{ seconds: 1*86400, label: "1 day" },
{ seconds: 2*86400, label: "2 days" },
{ seconds: 3*86400, label: "3 days" }
];

// 2) per‐device state:
const lastStatusByDevice = new Map(); // tracks last "OFFLINE" vs anything else
const alertedMilestones = new Map(); // tracks which milestones fired
function checkVehicleAlerts() {
fetch('/api/vehicle/last/latests-locations/all')
.then(r => r.json())
.then(data => {
const now = Date.now();
data.forEach(v => {
const id = v.deviceId;
if (!id) return;

const ts = new Date(v.timestamp).getTime();
const elapsedSec = (now - ts) / 1000;

const [run, park, idle] = (v.timeIntervals||"0,0,0")
.split(',').map(n=>+n||0);

const current = computeStatus(v.vehicleStatus, run, park, idle, elapsedSec, 5);

const prev = lastStatusByDevice.get(id) || "UNKNOWN";
if (current === "OFFLINE" && prev !== "OFFLINE") {
showOfflineToast(id, ts);
}
lastStatusByDevice.set(id, current);

if (current === "OFFLINE") {
let msSet = alertedMilestones.get(id);
if (!msSet) {
msSet = new Set();
alertedMilestones.set(id, msSet);
}

milestones.forEach(m => {
if (elapsedSec >= m.seconds && !msSet.has(m.seconds)) {
showOfflineToast(id, ts);
msSet.add(m.seconds);
}
});
}
});
});
}

