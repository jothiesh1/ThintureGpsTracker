iconAnchor: [17, 17], // Center the icon
popupAnchor: [0, -15]
});
}

zoomToVehicle(deviceId, latitude, longitude) {
if (!this.map) {
console.error("❌ Map not initialized.");
return;
}
if (latitude == null || longitude == null) {
console.error(`❌ Missing coordinates for device ${deviceId}`);
return;
}

