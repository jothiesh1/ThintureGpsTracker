// Helpers (only defined once)
function formatUtcTime(ts) {
const d = new Date(ts);
return d.toISOString().replace('T',' ').substr(0,19);
}

function computeStatus(raw, run, park, idle, elapsed, slack = 5) {
const status = (raw||'').toUpperCase();
if ((status==='RUNNING'||status==='MOVING') && run>0) return elapsed<=run+slack ? status : 'OFFLINE';
if (status==='PARKED' && park>0) return elapsed<=park+slack ? 'PARKED' : 'OFFLINE';
if (status==='IDLE' && idle>0) return elapsed<=idle+slack ? 'IDLE' : 'OFFLINE';
return 'OFFLINE';
}

window.updateSidebarTable = function(vehicles) {
const now = Date.now();
const rows = vehicles.map(v => {
const [run, park, idle] = (v.timeIntervals||'0,0,0').split(',').map(n=>+n||0);
const ts = new Date(v.timestamp).getTime(), elapsed=(now - ts)/1000;
const status = computeStatus(v.vehicleStatus, run, park, idle, elapsed);
return `
<tr data-device="${v.deviceId}">
<td>${status}</td>
<td>${v.deviceId}</td>
<td>${v.timeIntervals}</td>
<td>${formatUtcTime(v.timestamp)}</td>
<td><button onclick="zoomEffect(event,'${v.deviceId}',${+v.latitude},${+v.longitude})">Zoom</button></td>
</tr>`;
}).join('');
document.getElementById('trackerTableBody').innerHTML = rows;
paginateSidebarTable(); // if you're using pagination
};

// ——————— GLOBAL HELPER ———————
function updateSidebarRow(v, isLive = false) {
const tr = document.querySelector(`tr[data-device="${v.deviceId}"]`);
if (!tr) return;

// 1) Decide what text to show
const statusText = isLive
? 'LIVE'
: computeStatusForRow(v);

// 2) Update the status cell
const statusCell = tr.cells[0];
statusCell.textContent = statusText;

// 3) Color-code row + text
tr.classList.remove('table-success','table-warning','table-info','table-danger');
statusCell.className = '';
if (statusText === 'LIVE' || statusText === 'RUNNING') {
tr.classList.add('table-success');
statusCell.classList.add('text-success');
} else if (statusText === 'IDLE') {
tr.classList.add('table-warning');
statusCell.classList.add('text-warning');
} else if (statusText === 'PARKED') {
tr.classList.add('table-info');
statusCell.classList.add('text-info');
} else {
tr.classList.add('table-danger');
statusCell.classList.add('text-danger');
}

// 4) Refresh timestamp — always the server-sent string
const timeCell = tr.cells[3];
timeCell.textContent = v.timestamp;

// 5) If newly OFFLINE (and not live), update the offlineAlertList inline
if (!isLive && statusText === 'OFFLINE') {
const list = document.getElementById("offlineAlertList");
if (list) {
const liId = `offline-${v.deviceId}`;
let li = document.getElementById(liId);
const text = `Device ${v.deviceId} → Intervals: ${v.timeIntervals}`;

if (li) {
li.textContent = text;
} else {
li = document.createElement("li");
li.id = liId;
li.className = "list-group-item list-group-item-danger";
li.textContent = text;
list.appendChild(li);
}
}
}

// 6) Flash effect
tr.classList.add('bg-opacity-25');
setTimeout(() => tr.classList.remove('bg-opacity-25'), 200);
}

// ✅ NEW: Helper function for sidebar status computation
function computeStatusForRow(v) {
  const now = Date.now();
  const [run, park, idle] = (v.timeIntervals||'0,0,0').split(',').map(n=>+n||0);
  const ts = new Date(v.timestamp).getTime(), elapsed=(now - ts)/1000;
  return computeStatus(v.vehicleStatus, run, park, idle, elapsed);
}

// ———————————————————————————————————————

function autoRefreshData() {
fetch('/api/vehicle/last/latests-locations/all')
.then(res => res.json())
.then(data => {
const now = Date.now();

// 1) Filter out invalid and compute statuses
const validVehicles = data
.filter(v => {
const lat = parseFloat(v.latitude),
lng = parseFloat(v.longitude);
return !isNaN(lat) && !isNaN(lng)
&& v.deviceId && v.deviceId.trim().toLowerCase() !== 'null';
})
.map(v => {
// parse intervals
const [run=0, park=0, idle=0] = (v.timeIntervals || '0,0,0')
.split(',').map(n => parseInt(n, 10) || 0);

// elapsed seconds
const elapsed = (now - new Date(v.timestamp).getTime()) / 1000;

// recompute status
v.vehicleStatus = computeStatus(v.vehicleStatus, run, park, idle, elapsed, 5);
return v;
});

// 2) Update your dashboard
document.getElementById("totalCount").textContent = validVehicles.length;
document.getElementById("runningCount").textContent = validVehicles.filter(v => v.vehicleStatus==='RUNNING').length;
document.getElementById("idleCount").textContent = validVehicles.filter(v => v.vehicleStatus==='IDLE').length;
document.getElementById("parkedCount").textContent = validVehicles.filter(v => v.vehicleStatus==='PARKED').length;
document.getElementById("lostCount").textContent = validVehicles.filter(v => v.vehicleStatus==='OFFLINE').length;

window.vehicleTracker.updateMapMarkers(validVehicles);
window.updateSidebarTable(validVehicles);

// 3) Build list of OFFLINE devices showing only seconds
const offlineList = validVehicles
.filter(v => v.vehicleStatus === 'OFFLINE')
.map(v => {
const [run=0, park=0, idle=0] = (v.timeIntervals || '0,0,0')
.split(',').map(n => parseInt(n,10) || 0);
return `• ${v.deviceId} — ${run}s, ${park}s, ${idle}s`;
});

// 4) If any offline, show a single alert
if (offlineList.length) {
Swal.fire({
title: '🚨 Offline Devices',
html: offlineList.join('<br>'),
icon: 'error',
confirmButtonText: 'OK'
});
}
})
.catch(err => console.error('🚨 Error fetching vehicle data:', err));
}

